# ============================================================================

def print_operation_grid(
        operations,
        totals,
        columns=4,
        column_width=25):

    for start in range(
            0,
            len(operations),
            columns):

        parts = []

        for operation in operations[
                start:start + columns]:

            parts.append(
                '%-12s %10s'
                % (
                    operation,
                    format_rate(
                        totals.get(
                            operation,
                            0.0
                        )
                    )
                )
            )

        print '  '.join(
            parts
        )


