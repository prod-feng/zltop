def draw_screen(
        window,
        monitor):

    clear_window(
        window
    )

    height, width = (
        window.getmaxyx()
    )

    safe_addstr(
        window,
        0,
        0,
        'LUSTRE STORAGE MONITOR',
        curses.A_BOLD
    )

    totals = monitor.oss_totals()

    read_rate = totals[
        'read_bytes_rate'
    ]

    write_rate = totals[
        'write_bytes_rate'
    ]

    mdt_totals = (
        monitor.mdt_operation_totals()
    )

    mdt_iops = 0.0

    for value in mdt_totals.values():
        mdt_iops += value

    safe_addstr(
        window,
        1,
        0,
        (
            'Read %.2f MiB/s   '
            'Write %.2f MiB/s   '
            'MDT OPS %.1f/s'
        ) % (
            mib(read_rate),
            mib(write_rate),
            mdt_iops
        )
    )

    row = 3

    # ------------------------------------------------------------------------
    # Rates first.
    # ------------------------------------------------------------------------

    row = draw_oss_io(
        window,
        monitor,
        row
    )

    if row >= height - 2:
        window.refresh()
        return

    row = draw_operation_grid(
        window,
        row,
        'OSS OPERATIONS / SEC',
        OSS_OPERATIONS,
        monitor.oss_operation_totals(),
        25
    )

    if row >= height - 2:
        window.refresh()
        return

    row = draw_mdt(
        window,
        monitor,
        row
    )

    if row >= height - 2:
        window.refresh()
        return

    row = draw_operation_grid(
        window,
        row,
        'MDT DETAILED OPERATIONS / SEC',
        MDT_OPERATIONS,
        monitor.mdt_operation_totals(),
        28
    )

    if row >= height - 2:
        window.refresh()
        return

    # ------------------------------------------------------------------------
    # STATUS.
    # ------------------------------------------------------------------------

    row = draw_status(
        window,
        monitor,
        row
    )

    if row >= height - 2:
        window.refresh()
        return

    # ------------------------------------------------------------------------
    # Capacity and file counts deliberately moved to the bottom.
    # ------------------------------------------------------------------------

    row += 1

    row = draw_capacity(
        window,
        monitor,
        row
    )

    if row >= height - 2:
        window.refresh()
        return

    draw_files(
        window,
        monitor,
        row
    )

    safe_addstr(
        window,
        height - 1,
        0,
        'q=quit   r=refresh',
        curses.A_DIM
    )

    window.refresh()


# ============================================================================
# CURSES LOOP
# ============================================================================

def curses_main(
        window,
        monitor):

    try:

        curses.curs_set(0)

    except curses.error:

        pass

    window.nodelay(True)

    window.keypad(True)

    first = True

    while True:

        key = window.getch()

        if key in (
                ord('q'),
                ord('Q')):

            break

        force_refresh = (
            key in (
                ord('r'),
                ord('R')
            )
        )

        should_collect = first

        if not first:

            elapsed = (
                monotonic() -
                monitor.last_collection
            )

            if elapsed >= monitor.interval:

                should_collect = True

        if force_refresh:

            should_collect = True

        if should_collect:

            try:

                monitor.collect()

                draw_screen(
                    window,
                    monitor
                )

            except Exception as exc:

                clear_window(
                    window
                )

                safe_addstr(
                    window,
                    0,
                    0,
                    'ERROR',
                    curses.A_BOLD
                )

                safe_addstr(
                    window,
                    1,
                    0,
                    str(exc)
                )

                safe_addstr(
                    window,
                    3,
                    0,
                    'Press q to quit.'
                )

                window.refresh()

            first = False

        time.sleep(
            0.05
        )


# ============================================================================
