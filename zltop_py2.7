# ============================================================================
# DATA CLASSES
# ============================================================================

class Target(object):

    def __init__(self, name):

        self.name = name

        self.metrics = {}

        self.previous_metrics = {}

        self.rates = {}

        self.timestamp = 0.0

        self.previous_timestamp = 0.0

        self.success = False

        self.error = ''


class CollectionResult(object):

    def __init__(
            self,
            host,
            role,
            output='',
            error='',
            returncode=0):

        self.host = host
        self.role = role
        self.output = output
        self.error = error
        self.returncode = returncode

        self.success = (
            returncode == 0 and
            not error
        )


# ============================================================================
# GENERAL UTILITIES
# ============================================================================

def safe_float(value, default=0.0):

    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def safe_int(value, default=0):

    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def counter_rate(current, previous, elapsed):

    if elapsed <= 0:
        return 0.0

    if current < previous:
        # Counter was reset, probably because of restart/reboot.
        return 0.0

    return (
        current - previous
    ) / elapsed


def mib(value):

    return value / (
        1024.0 * 1024.0
    )


def gib(value):

    return value / (
        1024.0 *
        1024.0 *
        1024.0
    )


def tib(value):

    return value / (
        1024.0 *
        1024.0 *
        1024.0 *
        1024.0
    )


def percent(used, total):

    if total <= 0:
        return 0.0

    return (
        100.0 *
        used /
        total
    )


def clamp(value, low, high):

    if value < low:
        return low

    if value > high:
        return high

    return value


def format_number(value):

    if abs(value) >= 1000000:
        return '%.1fM' % (
            value / 1000000.0
        )

    if abs(value) >= 1000:
        return '%.1fK' % (
            value / 1000.0
        )

    return '%.1f' % value


def format_rate(value):

    if abs(value) >= 1000000:
        return '%.1fM' % (
            value / 1000000.0
        )

    if abs(value) >= 1000:
        return '%.1fK' % (
            value / 1000.0
        )

    return '%.1f' % value


def format_mib_rate(value):

    return '%.2f' % mib(value)


# ============================================================================
# PARSING HELPERS
# ============================================================================

def parse_key_value_line(line):

    if '=' not in line:
        return None, None

    key, value = line.split(
        '=',
        1
    )

    return (
        key.strip(),
        value.strip()
    )


def get_lustre_target_name(parameter):

    parameter = parameter.strip()

    parts = parameter.split('.')

    if len(parts) < 2:
        return parameter

    target = parts[1]

    return target


def get_parameter_name(parameter):

    parts = parameter.strip().split('.')

    if not parts:
        return ''

    return parts[-1]


def parse_capacity_output(output):

    result = {}

    for line in output.splitlines():

        line = line.strip()

        if not line:
            continue

        key, value = parse_key_value_line(
            line
        )

        if key is None:
            continue

        target = get_lustre_target_name(
            key
        )

        parameter = get_parameter_name(
            key
        )

        if not target:
            continue

        if not parameter:
            continue

        if target not in result:
            result[target] = {}

        result[target][parameter] = safe_float(
            value
        )

    return result


def parse_stats_counter_line(line):

    fields = line.strip().split()

    if len(fields) < 2:
        return None, None

    operation = fields[0]

    if operation == 'snapshot_time':

        if len(fields) >= 2:

            timestamp = safe_float(
                fields[1],
                None
            )

            return (
                'snapshot_time',
                timestamp
            )

        return (
            'snapshot_time',
            None
        )

    if 'samples' not in fields:

        return None, None

    samples_index = fields.index(
        'samples'
    )

    numeric_values = []

    for value in fields[1:]:

        if value == 'samples':
            break

        try:
            numeric_values.append(
                float(value)
            )
        except ValueError:
            pass

    # Bytes statistics.
    if (
            samples_index + 1 < len(fields) and
            fields[samples_index + 1] == '[bytes]'):

        values_after_units = []

        for value in fields[
                samples_index + 2:]:
            try:
                values_after_units.append(
                    float(value)
                )
            except ValueError:
                pass

        if values_after_units:

            return (
                operation,
                values_after_units[-1]
            )

        if numeric_values:

            return (
                operation,
                numeric_values[0]
            )

        return (
            operation,
            None
        )

    # Request statistics.
    if (
            samples_index + 1 < len(fields) and
            fields[samples_index + 1] == '[reqs]'):

        values_after_units = []

        for value in fields[
                samples_index + 2:]:
            try:
                values_after_units.append(
                    float(value)
                )
            except ValueError:
                pass

        if values_after_units:

            return (
                operation,
                values_after_units[-1]
            )

        if numeric_values:

            return (
                operation,
                numeric_values[0]
            )

        return (
            operation,
            None
        )

    # Generic fallback.
    if numeric_values:

        return (
            operation,
            numeric_values[-1]
        )

    return (
        operation,
        None
    )


def parse_stats_output(output):

    result = {}

    for line in output.splitlines():

        line = line.strip()

        if not line:
            continue

        if line.endswith('='):
            continue

        key, value = parse_stats_counter_line(
            line
        )

        if key is None:
            continue

        if value is None:
            continue

        result[key] = value

    return result


# ============================================================================
# SSH
# ============================================================================

def run_ssh_lctl(
        host,
        params,
        timeout):

    command = [
        'ssh',
        '-o',
        'BatchMode=yes',
        '-o',
        'ConnectTimeout=%d' % int(timeout),
        host,
        '/usr/sbin/lctl',
        'get_param'
    ]

    command.extend(params)

    try:

        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )

    except OSError as exc:

        return CollectionResult(
            host,
            '',
            '',
            str(exc),
            1
        )

    try:

        stdout_data, stderr_data = (
            process.communicate()
        )

    except Exception as exc:

        try:
            process.kill()
        except Exception:
            pass

        return CollectionResult(
            host,
            '',
            '',
            str(exc),
            1
        )

    if process.returncode != 0:

        error = stderr_data.strip()

        if not error:
            error = (
                'ssh/lctl returned '
                'status %d'
                % process.returncode
            )

        return CollectionResult(
            host,
            '',
            stdout_data,
            error,
            process.returncode
        )

    return CollectionResult(
        host,
        '',
        stdout_data,
        '',
        0
    )


# ============================================================================
# PARALLEL SSH COLLECTION
# ============================================================================

def collect_host(
        host,
        role,
        parameter_groups,
        timeout):

    all_output = []

    errors = []

    for params in parameter_groups:

        result = run_ssh_lctl(
            host,
            params,
            timeout
        )

        if not result.success:

            errors.append(
                result.error
            )

            continue

        all_output.append(
            result.output
        )

    if errors:

        return CollectionResult(
            host,
            role,
            '\n'.join(all_output),
            '; '.join(errors),
            1
        )

    return CollectionResult(
        host,
        role,
        '\n'.join(all_output),
        '',
        0
    )


def parallel_collect(
        hosts,
        role,
        parameter_groups,
        timeout):

    results = {}

    threads = []

    lock = threading.Lock()

    def worker(host):

        result = collect_host(
            host,
            role,
            parameter_groups,
            timeout
        )

        lock.acquire()

        try:
            results[host] = result
        finally:
            lock.release()

    for host in hosts:

        thread = threading.Thread(
            target=worker,
            args=(host,)
        )

        thread.daemon = True

        thread.start()

        threads.append(thread)

    for thread in threads:

        thread.join(
            timeout + 30
        )

    for host in hosts:

        if host not in results:

            results[host] = CollectionResult(
                host,
                role,
                '',
                'collection timeout',
                1
            )

    return results


# ============================================================================
# TARGET METRIC STORAGE
# ============================================================================

class TargetStore(object):

    def __init__(self):

        self.targets = {}

    def get(self, name):

        if name not in self.targets:

            self.targets[name] = Target(
                name
            )

        return self.targets[name]

    def update(
            self,
            name,
            metrics,
            timestamp,
            success=True,
            error=''):

        target = self.get(
            name
        )

        if target.success:

            target.previous_metrics = dict(
                target.metrics
            )

            target.previous_timestamp = (
                target.timestamp
            )

        else:

            target.previous_metrics = {}

            target.previous_timestamp = 0.0

        target.metrics = dict(
            metrics
        )

        target.timestamp = timestamp

        target.success = success

        target.error = error

        target.rates = {}

        if not success:
            return

        if not target.previous_metrics:
            return

        elapsed = (
            target.timestamp -
            target.previous_timestamp
        )

        if elapsed <= 0:
            return

        for key in target.metrics:

            if key not in target.previous_metrics:
                continue

            current = target.metrics[key]

            previous = target.previous_metrics[key]

            target.rates[key] = counter_rate(
                current,
                previous,
                elapsed
            )

    def values(self):

        return self.targets.values()


# ============================================================================
# MULTI-TARGET STATS PARSER
# ============================================================================

def parse_stats_by_target(
        output,
        target_type):

    result = {}

    current_target = None

    current_lines = []

    for raw_line in output.splitlines():

        line = raw_line.strip()

        if not line:
            continue

        if '=' in line:

            left, right = (
                line.split('=', 1)
            )

            left = left.strip()

            lower_left = left.lower()

            is_oss_stats = (
                '.stats' in lower_left
            )

            is_mdt_stats = (
                '.md_stats' in lower_left
            )

            if (
                    (target_type == 'OST' and
                     is_oss_stats) or
                    (target_type == 'MDT' and
                     is_mdt_stats)):

                if (
                        current_target is not None and
                        current_lines):

                    result[
                        current_target
                    ] = parse_stats_output(
                        '\n'.join(
                            current_lines
                        )
                    )

                current_target = (
                    get_lustre_target_name(
                        left
                    )
                )

                current_lines = []

                continue

        if current_target is not None:

            current_lines.append(
                line
            )

    if (
            current_target is not None and
            current_lines):

        result[
            current_target
        ] = parse_stats_output(
            '\n'.join(
                current_lines
            )
        )

    return result


# ============================================================================
# MONITOR
# ============================================================================

class LustreMonitor(object):

    def __init__(
            self,
            oss_hosts,
            mds_hosts,
            interval=3.0,
            ssh_timeout=15.0):

        self.oss_hosts = list(
            oss_hosts
        )

        self.mds_hosts = list(
            mds_hosts
        )

        self.interval = interval

        self.ssh_timeout = ssh_timeout

        self.oss = TargetStore()

        self.mdt = TargetStore()

        self.last_collection = 0.0

        self.oss_errors = {}

        self.mds_errors = {}

    # ------------------------------------------------------------------------
    # COLLECT OSS
    # ------------------------------------------------------------------------

    def collect_oss(self):

        parameter_groups = [
            OSS_CAPACITY_PARAMS,
            OSS_FILE_PARAMS,
            OSS_STATS_PARAMS,
        ]

        results = parallel_collect(
            self.oss_hosts,
            'OSS',
            parameter_groups,
            self.ssh_timeout
        )

        self.oss_errors = {}

        for host in self.oss_hosts:

            result = results[host]

            if not result.success:

                self.oss_errors[host] = (
                    result.error
                )

                continue

            capacity = parse_capacity_output(
                result.output
            )

            stats_by_target = (
                parse_stats_by_target(
                    result.output,
                    'OST'
                )
            )

            target_names = set()

            for name in capacity:
                target_names.add(name)

            for name in stats_by_target:
                target_names.add(name)

            for target_name in target_names:

                metrics = {}

                if target_name in capacity:

                    metrics.update(
                        capacity[target_name]
                    )

                if target_name in stats_by_target:

                    metrics.update(
                        stats_by_target[
                            target_name
                        ]
                    )

                timestamp = metrics.get(
                    'snapshot_time',
                    time.time()
                )

                self.oss.update(
                    target_name,
                    metrics,
                    timestamp,
                    True,
                    ''
                )

    # ------------------------------------------------------------------------
    # COLLECT MDT
    # ------------------------------------------------------------------------

    def collect_mdt(self):

        parameter_groups = [
            MDT_CAPACITY_PARAMS,
            MDT_FILE_PARAMS,
            MDT_STATS_PARAMS,
        ]

        results = parallel_collect(
            self.mds_hosts,
            'MDS',
            parameter_groups,
            self.ssh_timeout
        )

        self.mds_errors = {}

        for host in self.mds_hosts:

            result = results[host]

            if not result.success:

                self.mds_errors[host] = (
                    result.error
                )

                continue

            capacity = parse_capacity_output(
                result.output
            )

            stats_by_target = (
                parse_stats_by_target(
                    result.output,
                    'MDT'
                )
            )

            target_names = set()

            for name in capacity:
                target_names.add(name)

            for name in stats_by_target:
                target_names.add(name)

            for target_name in target_names:

                metrics = {}

                if target_name in capacity:

                    metrics.update(
                        capacity[target_name]
                    )

                if target_name in stats_by_target:

                    metrics.update(
                        stats_by_target[
                            target_name
                        ]
                    )

                timestamp = metrics.get(
                    'snapshot_time',
                    time.time()
                )

                self.mdt.update(
                    target_name,
                    metrics,
                    timestamp,
                    True,
                    ''
                )

    # ------------------------------------------------------------------------
    # COLLECT EVERYTHING
    # ------------------------------------------------------------------------

    def collect(self):

        self.collect_oss()

        self.collect_mdt()

        self.last_collection = monotonic()

    # ------------------------------------------------------------------------
    # OSS TOTALS
    # ------------------------------------------------------------------------

    def oss_totals(self):

        result = {
            'kbytesavail': 0.0,
            'kbytesfree': 0.0,
            'kbytestotal': 0.0,
            'filesfree': 0.0,
            'filestotal': 0.0,
            'read_bytes_rate': 0.0,
            'write_bytes_rate': 0.0,
        }

        for target in self.oss.values():

            if not target.success:
                continue

            result['kbytesavail'] += (
                target.metrics.get(
                    'kbytesavail',
                    0.0
                )
            )

            result['kbytesfree'] += (
                target.metrics.get(
                    'kbytesfree',
                    0.0
                )
            )

            result['kbytestotal'] += (
                target.metrics.get(
                    'kbytestotal',
                    0.0
                )
            )

            result['filesfree'] += (
                target.metrics.get(
                    'filesfree',
                    0.0
                )
            )

            result['filestotal'] += (
                target.metrics.get(
                    'filestotal',
                    0.0
                )
            )

            result['read_bytes_rate'] += (
                target.rates.get(
                    'read_bytes',
                    0.0
                )
            )

            result['write_bytes_rate'] += (
                target.rates.get(
                    'write_bytes',
                    0.0
                )
            )

        return result

    # ------------------------------------------------------------------------
    # MDT TOTALS
    # ------------------------------------------------------------------------

    def mdt_operation_totals(self):

        result = {}

        for operation in MDT_OPERATIONS:

            result[operation] = 0.0

        for target in self.mdt.values():

            if not target.success:
                continue

            for operation in MDT_OPERATIONS:

                result[operation] += (
                    target.rates.get(
                        operation,
                        0.0
                    )
                )

        return result

    # ------------------------------------------------------------------------
    # OSS OPERATION TOTALS
    # ------------------------------------------------------------------------

    def oss_operation_totals(self):

        result = {}

        for operation in OSS_OPERATIONS:

            result[operation] = 0.0

        for target in self.oss.values():

            if not target.success:
                continue

            for operation in OSS_OPERATIONS:

                result[operation] += (
                    target.rates.get(
                        operation,
                        0.0
                    )
                )

        return result


# ============================================================================
# CURSES HELPERS
# ============================================================================

def safe_addstr(
        window,
        row,
        column,
        text,
        attribute=0):

    try:

        height, width = (
            window.getmaxyx()
        )

        if row < 0:
            return

        if row >= height:
            return

        if column < 0:
            return

        if column >= width:
            return

        available = (
            width -
            column -
            1
        )

        if available <= 0:
            return

        window.addstr(
            row,
            column,
            str(text)[:available],
            attribute
        )

    except curses.error:

        pass


def clear_window(window):

    try:
        window.erase()
    except curses.error:
        pass


# ============================================================================
# DRAW COMPACT 4-COLUMN OPERATIONS
# ============================================================================

def draw_operation_grid(
        window,
        row,
        title,
        operations,
        totals,
        column_width=25):

    safe_addstr(
        window,
        row,
        0,
        title,
        curses.A_BOLD
    )

    row += 1

    width = window.getmaxyx()[1]

    columns = max(
        1,
        min(
            4,
            width // column_width
        )
    )

    for index, operation in enumerate(
            operations):

        column = index % columns

        if column == 0 and index > 0:
            row += 1

        x = column * column_width

        text = (
            '%-15s %10s'
            % (
                operation,
                format_rate(
                    totals.get(
                        operation,
                        0.0
                    )
                )
            )
        )

        safe_addstr(
            window,
            row,
            x,
            text
        )

    rows = (
        (len(operations) + columns - 1)
        // columns
    )

    return row + rows + 1


