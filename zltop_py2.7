        0,
        'STATUS',
        curses.A_BOLD
    )

    row += 1

    oss_ok = []
    oss_bad = []

    for host in monitor.oss_hosts:

        if host in monitor.oss_errors:
            oss_bad.append(
                '%s:%s' % (
                    host,
                    monitor.oss_errors[host]
                )
            )
        else:
            oss_ok.append(host)

    mds_ok = []
    mds_bad = []

    for host in monitor.mds_hosts:

        if host in monitor.mds_errors:
            mds_bad.append(
                '%s:%s' % (
                    host,
                    monitor.mds_errors[host]
                )
            )
        else:
            mds_ok.append(host)

    if oss_bad:

        oss_text = (
            'OSS OK[%s] ERROR[%s]'
