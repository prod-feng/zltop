# COMMAND LINE
# ============================================================================

def parse_arguments():

    parser = argparse.ArgumentParser(
        description=(
            'Lustre storage performance '
            'monitor for Python 2.7.'
        )
    )

    parser.add_argument(
        '--oss',
        action='append',
        dest='oss_hosts',
        help=(
            'OSS hostname. '
            'Can be specified multiple times.'
        )
    )

    parser.add_argument(
        '--mds',
        action='append',
        dest='mds_hosts',
        help=(
            'MDS hostname. '
            'Can be specified multiple times.'
        )
    )

    parser.add_argument(
        '--interval',
        type=float,
        default=DEFAULT_INTERVAL,
        help=(
            'Polling interval in seconds. '
            'Default: 3'
        )
    )

    parser.add_argument(
        '--ssh-timeout',
        type=float,
        default=DEFAULT_SSH_TIMEOUT,
        help=(
            'SSH timeout in seconds. '
            'Default: 15'
        )
    )

    parser.add_argument(
        '--once',
        action='store_true',
        help=(
            'Collect once and print text. '
            'Useful for debugging.'
        )
    )

    return parser.parse_args()


# ============================================================================
# MAIN
# ============================================================================

def main():

    args = parse_arguments()

    if args.oss_hosts:

        oss_hosts = args.oss_hosts

    else:

        oss_hosts = DEFAULT_OSS_HOSTS

    if args.mds_hosts:

        mds_hosts = args.mds_hosts

    else:

        mds_hosts = DEFAULT_MDS_HOSTS

    if args.interval <= 0:

        print >> sys.stderr, (
            'ERROR: interval must be > 0'
        )

        return 1

    if args.ssh_timeout <= 0:

        print >> sys.stderr, (
            'ERROR: ssh timeout must be > 0'
        )

        return 1

    monitor = LustreMonitor(
        oss_hosts,
        mds_hosts,
        args.interval,
        args.ssh_timeout
    )

    if args.once:

        try:

            print_once(
                monitor
            )

        except KeyboardInterrupt:

            return 130

        except Exception as exc:

            print >> sys.stderr, (
                'ERROR: %s'
                % str(exc)
            )

            return 1

        return 0

    try:

        curses.wrapper(
            curses_main,
            monitor
        )

    except KeyboardInterrupt:

        return 130

    except Exception as exc:

        print >> sys.stderr, (
            'ERROR: %s'
            % str(exc)
        )

        return 1

    return 0


# ============================================================================
# ENTRY POINT
# ============================================================================

if __name__ == '__main__':

    sys.exit(
        main()
    )
