#!/usr/bin/env python2
# -*- coding: utf-8 -*-

"""
Lustre Storage Performance Monitor
==================================

Python 2.7 compatible.

Purpose:
    Lightweight monitoring of Lustre OSS and MDS performance.

Requirements:
    - Python 2.7
    - ssh
    - /usr/sbin/lctl on remote Lustre servers
    - SSH key authentication
    - curses

Usage:

    python lustre_monitor.py

    python lustre_monitor.py --oss oss1 --oss oss2 --mds mds1

    python lustre_monitor.py --interval 5

    python lustre_monitor.py --once

Keys:

    q       Quit
    r       Refresh immediately
"""

import argparse
import curses
import re
import subprocess
import sys
import threading
import time


# ============================================================================
# PYTHON 2.7 COMPATIBILITY
# ============================================================================

try:
    monotonic = time.monotonic
except AttributeError:
    monotonic = time.time


# ============================================================================
# DEFAULT CONFIGURATION
# ============================================================================

DEFAULT_OSS_HOSTS = [
    'oss1',
    'oss2',
]

DEFAULT_MDS_HOSTS = [
    'mds1',
]

DEFAULT_INTERVAL = 3.0
DEFAULT_SSH_TIMEOUT = 10.0


# ============================================================================
# LUSTRE PARAMETERS
# ============================================================================

OSS_PARAMS = [
    'obdfilter.*-OST*.kbyte*',
    'obdfilter.*-OST*.file*',
    'obdfilter.*-OST*.stats',
]

MDS_PARAMS = [
    'osd*.*MDT*.kbyte*',
    'osd*.*MDT*.files*',
    'mdt.*MDT*.md_stats',
]


# ============================================================================
# MDT OPERATIONS
# ============================================================================

MDT_OPERATIONS = [
    'open',
    'close',
    'mknod',
    'link',
    'unlink',
    'mkdir',
    'rmdir',
    'rename',
    'getattr',
    'setattr',
    'getxattr',
    'setxattr',
    'statfs',
    'sync',
    'samedir_rename',
    'crossdir_rename',
]


# ============================================================================
# DATA STRUCTURES
# ============================================================================

class HostResult(object):

    def __init__(self, host, role, success, lines=None, error=''):

        self.host = host
        self.role = role
        self.success = success

        if lines is None:
            lines = []

        self.lines = lines
        self.error = error


class HostMetrics(object):

    def __init__(self):

        self.current = {}
        self.previous = {}
        self.rates = {}

        self.current_time = 0.0
        self.previous_time = 0.0

        self.success = True
        self.error = ''


class SystemMetrics(object):

    def __init__(self):

        self.files_total = 0.0
        self.files_free = 0.0

        self.kbytes_total = 0.0
        self.kbytes_free = 0.0

        self.read_bytes_per_sec = 0.0
        self.write_bytes_per_sec = 0.0

        self.mdt_rates = {}


# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

def safe_float(value, default=0.0):

    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def calculate_rate(current, previous, elapsed):

    if elapsed <= 0:
        return 0.0

    # Lustre counters can reset after a reboot or service restart.
    if current < previous:
        return 0.0

    return (current - previous) / elapsed


def bytes_to_mib(value):

    return value / (1024.0 * 1024.0)


def kbytes_to_tib(value):

    return value / (
        1024.0 *
        1024.0 *
        1024.0
    )


def percent_used(total, free):

    if total <= 0:
        return 0.0

    used = total - free

    if used < 0:
        used = 0.0

    return 100.0 * used / total


def extract_numbers(text):

    pattern = (
        r'[-+]?(?:'
        r'\d+(?:\.\d*)?'
        r'|'
        r'\.\d+'
        r')(?:[eE][-+]?\d+)?'
    )

    values = []

    for value in re.findall(pattern, text):

        try:
            values.append(float(value))
        except ValueError:
            pass

    return values


def extract_first_number(text):

    values = extract_numbers(text)

    if not values:
        return None

    return values[0]


def normalize_key(key):

    key = key.strip()

    if '.' in key:
        key = key.split('.')[-1]

    return key.strip()


# ============================================================================
# SSH COMMAND
# ============================================================================

def build_lctl_command(host, params, timeout):

    connect_timeout = max(1, int(timeout))

    command = [
        'ssh',
        '-o',
        'BatchMode=yes',
        '-o',
        'ConnectTimeout=%d' % connect_timeout,
        host,
        '/usr/sbin/lctl',
        'get_param'
    ]

    command.extend(params)

    return command


# ============================================================================
# TERMINATE PROCESS
# ============================================================================

def terminate_process(process):

    try:
        process.terminate()
    except Exception:
        pass


# ============================================================================
# FETCH ONE HOST
# ============================================================================

def fetch_host(host, role, params, timeout):

    command = build_lctl_command(
        host,
        params,
        timeout
    )

    try:

        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )

    except OSError as exc:

        return HostResult(
            host,
            role,
            False,
            error=str(exc)
        )

    timer = threading.Timer(
        timeout + 5.0,
        terminate_process,
        [process]
    )

    timer.daemon = True
    timer.start()

    try:

        stdout_data, stderr_data = process.communicate()

    finally:

        timer.cancel()

    if process.returncode != 0:

        error = stderr_data.strip()

        if not error:

            error = (
                'ssh/lctl exited with status %d'
                % process.returncode
            )

        return HostResult(
            host,
            role,
            False,
            error=error
        )

    return HostResult(
        host,
        role,
        True,
        lines=stdout_data.splitlines()
    )


# ============================================================================
# THREAD WORKER
# ============================================================================

def collection_worker(
        host,
        role,
        params,
        timeout,
        results,
        lock):

    result = fetch_host(
        host,
        role,
        params,
        timeout
    )

    lock.acquire()

    try:
        results[host] = result
    finally:
        lock.release()


# ============================================================================
# COLLECT MULTIPLE HOSTS IN PARALLEL
# ============================================================================

def collect_hosts(
        hosts,
        role,
        params,
        timeout):

    results = {}

    threads = []

    lock = threading.Lock()

    for host in hosts:

        thread = threading.Thread(
            target=collection_worker,
            args=(
                host,
                role,
                params,
                timeout,
                results,
                lock
            )
        )

        thread.daemon = True

        thread.start()

        threads.append(thread)

    for thread in threads:

        thread.join(
            timeout + 7.0
        )

    for host in hosts:

        if host not in results:

            results[host] = HostResult(
                host,
                role,
                False,
                error='collection timeout'
            )

    return results


# ============================================================================
# PARSE ONE MDT/OST STATISTICS LINE
# ============================================================================

def parse_stat_line(line, role):

    fields = line.strip().split()

    if len(fields) < 2:
        return None, None

    key = normalize_key(fields[0])

    # ------------------------------------------------------------------------
    # snapshot_time
    # ------------------------------------------------------------------------

    if key == 'snapshot_time':

        value = extract_first_number(
            ' '.join(fields[1:])
        )

        return key, value

    # ------------------------------------------------------------------------
    # MDT md_stats
    #
    # Typical Lustre output:
    #
    # open 0 14180345 samples [reqs]
    #
    # close 1 10131059 samples [reqs]
    #
    # The accumulated counter is normally the second numeric field.
    # ------------------------------------------------------------------------

    if role == 'MDT':

        values = []

        for field in fields[1:]:

            value = extract_first_number(field)

            if value is not None:
                values.append(value)

        if len(values) >= 2:
            return key, values[1]

        if len(values) == 1:
            return key, values[0]

        return None, None

    # ------------------------------------------------------------------------
    # Generic statistics line
    # ------------------------------------------------------------------------

    value = extract_first_number(
        ' '.join(fields[1:])
    )

    return key, value


# ============================================================================
# PARSE LCTL OUTPUT
# ============================================================================

def parse_host_lines(lines, role):

    metrics = {}

    for raw_line in lines:

        line = raw_line.strip()

        if not line:
            continue

        # --------------------------------------------------------------------
        # key=value format
        #
        # Example:
        #
        # obdfilter.foo-OST0000.kbytesavail=123456
        # --------------------------------------------------------------------

        if '=' in line:

            left, right = line.split('=', 1)

            key = normalize_key(left)

            value = extract_first_number(right)

            if key and value is not None:

                metrics[key] = value

            continue

        # --------------------------------------------------------------------
        # Statistics format
        # --------------------------------------------------------------------

        key, value = parse_stat_line(
            line,
            role
        )

        if key and value is not None:

            metrics[key] = value

    return metrics


# ============================================================================
# CONVERT HOST RESULT TO METRICS
# ============================================================================

def parse_host_result(result):

    metrics = HostMetrics()

    if not result.success:

        metrics.success = False
        metrics.error = result.error

        return metrics

    metrics.current = parse_host_lines(
        result.lines,
        result.role
    )

    timestamp = metrics.current.get(
        'snapshot_time'
    )

    if timestamp is not None:

        metrics.current_time = timestamp

    else:

        metrics.current_time = time.time()

    return metrics


# ============================================================================
# CALCULATE HOST RATES
# ============================================================================

def calculate_host_rates(metrics):

    if not metrics.success:
        metrics.rates = {}
        return

    if not metrics.previous:
        metrics.rates = {}
        return

    elapsed = (
        metrics.current_time -
        metrics.previous_time
    )

    if elapsed <= 0:
        metrics.rates = {}
        return

    rates = {}

    for key in metrics.current:

        if key not in metrics.previous:
            continue

        current_value = metrics.current[key]

        previous_value = metrics.previous[key]

        rates[key] = calculate_rate(
            current_value,
            previous_value,
            elapsed
        )

    metrics.rates = rates


# ============================================================================
# AGGREGATE OSS DATA
# ============================================================================

def aggregate_ost_metrics(ost_metrics):

    system = SystemMetrics()

    for metrics in ost_metrics.values():

        if not metrics.success:
            continue

        system.files_total += (
            metrics.current.get(
                'filestotal',
                0.0
            )
        )

        system.files_free += (
            metrics.current.get(
                'filesfree',
                0.0
            )
        )

        system.kbytes_total += (
            metrics.current.get(
                'kbytestotal',
                0.0
            )
        )

        system.kbytes_free += (
            metrics.current.get(
                'kbytesfree',
                0.0
            )
        )

        system.read_bytes_per_sec += (
            metrics.rates.get(
                'read_bytes',
                0.0
            )
        )

        system.write_bytes_per_sec += (
            metrics.rates.get(
                'write_bytes',
                0.0
            )
        )

    return system


# ============================================================================
# AGGREGATE MDT DATA
# ============================================================================

def aggregate_mdt_metrics(
        mdt_metrics,
        system):

    for operation in MDT_OPERATIONS:

        total = 0.0

        for metrics in mdt_metrics.values():

            if not metrics.success:
                continue

            total += (
                metrics.rates.get(
                    operation,
                    0.0
                )
            )

        system.mdt_rates[operation] = total


# ============================================================================
# LUSTRE MONITOR
# ============================================================================

class LustreMonitor(object):

    def __init__(
            self,
            oss_hosts,
            mds_hosts,
            interval=DEFAULT_INTERVAL,
            ssh_timeout=DEFAULT_SSH_TIMEOUT):

        self.oss_hosts = []

        for host in oss_hosts:

            if host not in self.oss_hosts:
                self.oss_hosts.append(host)

        self.mds_hosts = []

        for host in mds_hosts:

            if host not in self.mds_hosts:
                self.mds_hosts.append(host)

        self.interval = interval
        self.ssh_timeout = ssh_timeout

        self.ost_metrics = {}
        self.mdt_metrics = {}

        for host in self.oss_hosts:
            self.ost_metrics[host] = HostMetrics()

        for host in self.mds_hosts:
            self.mdt_metrics[host] = HostMetrics()

        self.system = SystemMetrics()

        self.last_poll_time = 0.0

    # ------------------------------------------------------------------------
    # COLLECT
    # ------------------------------------------------------------------------

    def collect(self):

        # --------------------------------------------------------------------
        # Collect OSS
        # --------------------------------------------------------------------

        ost_results = collect_hosts(
            self.oss_hosts,
            'OSS',
            OSS_PARAMS,
            self.ssh_timeout
        )

        # --------------------------------------------------------------------
        # Collect MDS
        # --------------------------------------------------------------------

        mdt_results = collect_hosts(
            self.mds_hosts,
            'MDT',
            MDS_PARAMS,
            self.ssh_timeout
        )

        # --------------------------------------------------------------------
        # Process OSS
        # --------------------------------------------------------------------

        new_ost_metrics = {}

        for host in self.oss_hosts:

            result = ost_results.get(host)

            if result is None:

                current = HostMetrics()

                current.success = False

                current.error = (
                    'No result returned'
                )

            else:

                current = parse_host_result(
                    result
                )

            previous = self.ost_metrics.get(host)

            if (
                previous is not None and
                previous.current and
                current.success
            ):

                current.previous = dict(
                    previous.current
                )

                current.previous_time = (
                    previous.current_time
                )

            calculate_host_rates(
                current
            )

            new_ost_metrics[host] = current

        self.ost_metrics = new_ost_metrics

        # --------------------------------------------------------------------
        # Process MDS
        # --------------------------------------------------------------------

        new_mdt_metrics = {}

        for host in self.mds_hosts:

            result = mdt_results.get(host)

            if result is None:

                current = HostMetrics()

                current.success = False

                current.error = (
                    'No result returned'
                )

            else:

                current = parse_host_result(
                    result
                )

            previous = self.mdt_metrics.get(host)

            if (
                previous is not None and
                previous.current and
                current.success
            ):

                current.previous = dict(
                    previous.current
                )

                current.previous_time = (
                    previous.current_time
                )

            calculate_host_rates(
                current
            )

            new_mdt_metrics[host] = current

        self.mdt_metrics = new_mdt_metrics

        # --------------------------------------------------------------------
        # Aggregate
        # --------------------------------------------------------------------

        self.system = aggregate_ost_metrics(
            self.ost_metrics
        )

        aggregate_mdt_metrics(
            self.mdt_metrics,
            self.system
        )

        self.last_poll_time = monotonic()

    # ------------------------------------------------------------------------
    # IOPS
    # ------------------------------------------------------------------------

    def calculate_iops(self):

        total = 0.0

        for operation in MDT_OPERATIONS:

            total += (
                self.system.mdt_rates.get(
                    operation,
                    0.0
                )
            )

        return total


# ============================================================================
# CURSES SAFE OUTPUT
# ============================================================================

def safe_addstr(
        window,
        row,
        column,
        text,
        attribute=0):

    try:

        height, width = window.getmaxyx()

        if row < 0:
            return

        if row >= height:
            return

        if column < 0:
            return

        if column >= width:
            return

        available = width - column - 1

        if available <= 0:
            return

        window.addstr(
            row,
            column,
            str(text)[:available],
            attribute
        )

    except curses.error:

        pass


# ============================================================================
# FORMATTERS
# ============================================================================

def format_mib_rate(bytes_per_second):

    return '%.3f MiB/s' % (
        bytes_to_mib(
            bytes_per_second
        )
    )


def format_rate(value):

    if abs(value) >= 1000:

        return '%.0f' % value

    return '%.1f' % value


# ============================================================================
# SUMMARY DISPLAY
# ============================================================================

def draw_summary(window, monitor):

    system = monitor.system

    files_total = system.files_total
    files_free = system.files_free

    files_used = max(
        0.0,
        files_total - files_free
    )

    files_percent = percent_used(
        files_total,
        files_free
    )

    space_total = system.kbytes_total
    space_free = system.kbytes_free

    space_used = max(
        0.0,
        space_total - space_free
    )

    space_percent = percent_used(
        space_total,
        space_free
    )

    safe_addstr(
        window,
        0,
        0,
        'Lustre Storage System Status',
        curses.A_BOLD
    )

    safe_addstr(
        window,
        1,
        0,
        (
            'Files : %.2fM used / '
            '%.2fM total (%.1f%%)'
        ) % (
            files_used / 1000000.0,
            files_total / 1000000.0,
            files_percent
        )
    )

    safe_addstr(
        window,
        2,
        0,
        (
            'Space : %.2f TiB used / '
            '%.2f TiB total (%.1f%%)'
        ) % (
            kbytes_to_tib(space_used),
            kbytes_to_tib(space_total),
            space_percent
        )
    )

    safe_addstr(
        window,
        3,
        0,
        (
            'Read: %s    '
            'Write: %s    '
            'IOPS: %s'
        ) % (
            format_mib_rate(
                system.read_bytes_per_sec
            ),
            format_mib_rate(
                system.write_bytes_per_sec
            ),
            format_rate(
                monitor.calculate_iops()
            )
        )
    )

    oss_ok = 0

    for metrics in monitor.ost_metrics.values():

        if metrics.success:
            oss_ok += 1

    mds_ok = 0

    for metrics in monitor.mdt_metrics.values():

        if metrics.success:
            mds_ok += 1

    safe_addstr(
        window,
        4,
        0,
        (
            'OSS: %d/%d responding    '
            'MDS: %d/%d responding'
        ) % (
            oss_ok,
            len(monitor.oss_hosts),
            mds_ok,
            len(monitor.mds_hosts)
        )
    )


# ============================================================================
# MDT DISPLAY
# ============================================================================

def draw_mdt_summary(window, monitor):

    rates = monitor.system.mdt_rates

    safe_addstr(
        window,
        6,
        0,
        'MDT Operations/sec',
        curses.A_BOLD
    )

    rows = [
        [
            ('open', 'open'),
            ('close', 'close'),
            ('getattr', 'getattr'),
            ('setattr', 'setattr')
        ],

        [
            ('link', 'link'),
            ('unlink', 'unlink'),
            ('mkdir', 'mkdir'),
            ('rmdir', 'rmdir')
        ],

        [
            ('rename', 'rename'),
            ('statfs', 'statfs'),
            ('getxattr', 'getxattr'),
            ('setxattr', 'setxattr')
        ]
    ]

    row = 7

    for row_metrics in rows:

        column = 0

        for display_name, key in row_metrics:

            value = rates.get(
                key,
                0.0
            )

            text = (
                '%s: %s/s'
                % (
                    display_name,
                    format_rate(value)
                )
            )

            safe_addstr(
                window,
                row,
                column,
                text
            )

            column += 20

        row += 1


# ============================================================================
# OSS DISPLAY
# ============================================================================

def draw_oss_table(
        window,
        monitor,
        start_row):

    safe_addstr(
        window,
        start_row,
        0,
        'OSS Performance',
        curses.A_BOLD
    )

    row = start_row + 1

    header = (
        '%-20s'
        '%15s'
        '%16s'
        '%20s'
        % (
            'OSS',
            'Read MiB/s',
            'Write MiB/s',
            'Status'
        )
    )

    safe_addstr(
        window,
        row,
        0,
        header
    )

    row += 1

    for host in monitor.oss_hosts:

        metrics = monitor.ost_metrics.get(
            host
        )

        if metrics is None:
            continue

        if metrics.success:

            read = bytes_to_mib(
                metrics.rates.get(
                    'read_bytes',
                    0.0
                )
            )

            write = bytes_to_mib(
                metrics.rates.get(
                    'write_bytes',
                    0.0
                )
            )

            text = (
                '%-20s'
                '%15.3f'
                '%16.3f'
                '%20s'
                % (
                    host,
                    read,
                    write,
                    'OK'
                )
            )

        else:

            error = metrics.error

            if len(error) > 20:
                error = error[:20]

            text = (
                '%-20s'
                '%15s'
                '%16s'
                '%20s'
                % (
                    host,
                    '--',
                    '--',
                    error
                )
            )

        safe_addstr(
            window,
            row,
            0,
            text
        )

        row += 1


# ============================================================================
# MDS DISPLAY
# ============================================================================

def draw_mds_table(
        window,
        monitor,
        start_row):

    safe_addstr(
        window,
        start_row,
        0,
        'MDS / MDT Status',
        curses.A_BOLD
    )

    row = start_row + 1

    for host in monitor.mds_hosts:

        metrics = monitor.mdt_metrics.get(
            host
        )

        if metrics is None:
            continue

        if metrics.success:

            open_rate = (
                metrics.rates.get(
                    'open',
                    0.0
                )
            )

            close_rate = (
                metrics.rates.get(
                    'close',
                    0.0
                )
            )

            getattr_rate = (
                metrics.rates.get(
                    'getattr',
                    0.0
                )
            )

            text = (
                '%-20s'
                'OK    '
                'open=%10.1f/s  '
                'close=%10.1f/s  '
                'getattr=%10.1f/s'
                % (
                    host,
                    open_rate,
                    close_rate,
                    getattr_rate
                )
            )

        else:

            text = (
                '%-20sERROR: %s'
                % (
                    host,
                    metrics.error
                )
            )

        safe_addstr(
            window,
            row,
            0,
            text
        )

        row += 1


# ============================================================================
# FOOTER
# ============================================================================

def draw_footer(window):

    height, width = window.getmaxyx()

    if height < 2:
        return

    safe_addstr(
        window,
        height - 1,
        0,
        'q: quit    r: refresh',
        curses.A_DIM
    )


# ============================================================================
# DRAW COMPLETE SCREEN
# ============================================================================

def draw_screen(window, monitor):

    window.erase()

    draw_summary(
        window,
        monitor
    )

    draw_mdt_summary(
        window,
        monitor
    )

    draw_oss_table(
        window,
        monitor,
        11
    )

    mds_row = (
        14 +
        len(monitor.oss_hosts)
    )

    draw_mds_table(
        window,
        monitor,
        mds_row
    )

    draw_footer(
        window
    )

    window.refresh()


# ============================================================================
# CURSES MAIN LOOP
# ============================================================================

def curses_main(
        stdscr,
        monitor):

    try:

        curses.curs_set(0)

    except curses.error:

        pass

    stdscr.nodelay(True)
    stdscr.keypad(True)

    first_cycle = True

    while True:

        key = stdscr.getch()

        # --------------------------------------------------------------------
        # Quit
        # --------------------------------------------------------------------

        if key in (
            ord('q'),
            ord('Q')
        ):

            break

        # --------------------------------------------------------------------
        # Manual refresh
        # --------------------------------------------------------------------

        force_refresh = (
            key in (
                ord('r'),
                ord('R')
            )
        )

        should_collect = first_cycle

        if not first_cycle:

            elapsed = (
                monotonic()
                -
                monitor.last_poll_time
            )

            if elapsed >= monitor.interval:

                should_collect = True

        if force_refresh:

            should_collect = True

        # --------------------------------------------------------------------
        # Collect data
        # --------------------------------------------------------------------

        if should_collect:

            try:

                monitor.collect()

                draw_screen(
                    stdscr,
                    monitor
                )

            except Exception as exc:

                stdscr.erase()

                safe_addstr(
                    stdscr,
                    0,
                    0,
                    'Monitoring error',
                    curses.A_BOLD
                )

                safe_addstr(
                    stdscr,
                    1,
                    0,
                    str(exc)
                )

                safe_addstr(
                    stdscr,
                    3,
                    0,
                    'Press q to exit.'
                )

                stdscr.refresh()

            first_cycle = False

        time.sleep(0.05)


# ============================================================================
# ONE-SHOT MODE
# ============================================================================

def print_once(monitor):

    monitor.collect()

    system = monitor.system

    print
    print 'Lustre Storage System Status'
    print '=' * 80

    files_used = max(
        0.0,
        system.files_total -
        system.files_free
    )

    space_used = max(
        0.0,
        system.kbytes_total -
        system.kbytes_free
    )

    print (
        'Files : %.2fM used / '
        '%.2fM total (%.1f%%)'
    ) % (
        files_used / 1000000.0,
        system.files_total / 1000000.0,
        percent_used(
            system.files_total,
            system.files_free
        )
    )

    print (
        'Space : %.2f TiB used / '
        '%.2f TiB total (%.1f%%)'
    ) % (
        kbytes_to_tib(space_used),
        kbytes_to_tib(system.kbytes_total),
        percent_used(
            system.kbytes_total,
            system.kbytes_free
        )
    )

    print (
        'Read  : %s'
        % format_mib_rate(
            system.read_bytes_per_sec
        )
    )

    print (
        'Write : %s'
        % format_mib_rate(
            system.write_bytes_per_sec
        )
    )

    print (
        'IOPS  : %s'
        % format_rate(
            monitor.calculate_iops()
        )
    )

    print
    print 'OSS'
    print '-' * 80

    for host in monitor.oss_hosts:

        metrics = monitor.ost_metrics.get(
            host
        )

        if metrics is None:
            continue

        if not metrics.success:

            print (
                '%-20sERROR: %s'
                % (
                    host,
                    metrics.error
                )
            )

            continue

        read = bytes_to_mib(
            metrics.rates.get(
                'read_bytes',
                0.0
            )
        )

        write = bytes_to_mib(
            metrics.rates.get(
                'write_bytes',
                0.0
            )
        )

        print (
            '%-20s'
            'read=%12.3f MiB/s  '
            'write=%12.3f MiB/s'
        ) % (
            host,
            read,
            write
        )

    print
    print 'MDS / MDT'
    print '-' * 80

    for host in monitor.mds_hosts:

        metrics = monitor.mdt_metrics.get(
            host
        )

        if metrics is None:
            continue

        if not metrics.success:

            print (
                '%-20sERROR: %s'
                % (
                    host,
                    metrics.error
                )
            )

            continue

        open_rate = (
            metrics.rates.get(
                'open',
                0.0
            )
        )

        close_rate = (
            metrics.rates.get(
                'close',
                0.0
            )
        )

        getattr_rate = (
            metrics.rates.get(
                'getattr',
                0.0
            )
        )

        print (
            '%-20s'
            'open=%10.1f/s  '
            'close=%10.1f/s  '
            'getattr=%10.1f/s'
        ) % (
            host,
            open_rate,
            close_rate,
            getattr_rate
        )

    print


# ============================================================================
# COMMAND-LINE ARGUMENTS
# ============================================================================

def parse_arguments():

    parser = argparse.ArgumentParser(
        description=(
            'Lightweight Lustre '
            'storage performance monitor.'
        )
    )

    parser.add_argument(
        '--oss',
        action='append',
        dest='oss_hosts',
        help=(
            'OSS hostname. '
            'Can be specified multiple times.'
        )
    )

    parser.add_argument(
        '--mds',
        action='append',
        dest='mds_hosts',
        help=(
            'MDS hostname. '
            'Can be specified multiple times.'
        )
    )

    parser.add_argument(
        '--interval',
        type=float,
        default=DEFAULT_INTERVAL,
        help=(
            'Polling interval in seconds. '
            'Default: %.1f'
            % DEFAULT_INTERVAL
        )
    )

    parser.add_argument(
        '--ssh-timeout',
        type=float,
        default=DEFAULT_SSH_TIMEOUT,
        help=(
            'SSH timeout in seconds. '
            'Default: %.1f'
            % DEFAULT_SSH_TIMEOUT
        )
    )

    parser.add_argument(
        '--once',
        action='store_true',
        help=(
            'Collect once and print text '
            'instead of using curses.'
        )
    )

    return parser.parse_args()


# ============================================================================
# MAIN
# ============================================================================

def main():

    args = parse_arguments()

    if args.oss_hosts:

        oss_hosts = args.oss_hosts

    else:

        oss_hosts = DEFAULT_OSS_HOSTS

    if args.mds_hosts:

        mds_hosts = args.mds_hosts

    else:

        mds_hosts = DEFAULT_MDS_HOSTS

    if args.interval <= 0:

        print >> sys.stderr, (
            'ERROR: --interval must be '
            'greater than zero.'
        )

        return 1

    if args.ssh_timeout <= 0:

        print >> sys.stderr, (
            'ERROR: --ssh-timeout must be '
            'greater than zero.'
        )

        return 1

    if not oss_hosts and not mds_hosts:

        print >> sys.stderr, (
            'ERROR: At least one OSS or '
            'MDS host must be specified.'
        )

        return 1

    monitor = LustreMonitor(
        oss_hosts,
        mds_hosts,
        args.interval,
        args.ssh_timeout
    )

    # ------------------------------------------------------------------------
    # One-shot mode
    # ------------------------------------------------------------------------

    if args.once:

        try:

            print_once(
                monitor
            )

        except KeyboardInterrupt:

            return 130

        except Exception as exc:

            print >> sys.stderr, (
                'ERROR: %s'
                % exc
            )

            return 1

        return 0

    # ------------------------------------------------------------------------
    # Curses mode
    # ------------------------------------------------------------------------

    try:

        curses.wrapper(
            curses_main,
            monitor
        )

    except KeyboardInterrupt:

        pass

    except Exception as exc:

        print >> sys.stderr, (
            'ERROR: %s'
            % exc
        )

        return 1

    return 0


# ============================================================================
# ENTRY POINT
# ============================================================================

if __name__ == '__main__':

    sys.exit(
        main()
    )
